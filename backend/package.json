{
  "name": "gestao-chamados-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx --env-file=../.env src/scripts/check-db.ts",
    "create-admin": "tsx --env-file=../.env src/scripts/create-admin.ts",
    "start": "node --env-file=../.env dist/server.js",
    "test": "node --import tsx --env-file=../.env --test src/tests/*.test.ts"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
